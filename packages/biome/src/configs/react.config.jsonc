{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	// `base.config.jsonc` turns these off ("Not applicable outside React apps") since it's
	// consumed by non-React packages too. Re-enabled here at the top level (not inside a
	// `.tsx`-scoped override) because hooks are frequently authored in plain `.ts` files
	// (e.g. `@flippo-ui/hooks`) — scoping this to `.tsx` only would silently stop catching
	// missing `useEffect`/`useCallback`/etc. dependencies in every hooks-only package.
	// Verified empirically: `domains.react: "recommended"` alone (below, `.tsx`-scoped) does
	// NOT override this — `base.config.jsonc`'s explicit "off" otherwise wins.
	"linter": {
		"rules": {
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "warn"
			}
		}
	},
	"overrides": [
		{
			// Provide support for React components.
			"includes": ["**/*.tsx", "!**/index.tsx"],
			"linter": {
        "domains": {
          "react": "recommended"
        },
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "warn"
          },
          "suspicious": {
						"noReactSpecificProps": "off" // Allow React-specific props such as `className` and `htmlFor`.
					},
          "style": {
            "noDefaultExport": "off" // Allow default exports of React components.
          }
        }
			}
		},
    {
      "includes": [
        "**/*.tsx",
        "!**/index.tsx",
        "!**/layout.tsx",
        "!**/loading.tsx",
        "!**/error.tsx",
        "!**/page.tsx",
        "!**/default.tsx",
        "!**/template.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "warn",
              "options": {
                "filenameCases": ["PascalCase"]
              }
            }
          }
        }
      }
    }
  ]
}